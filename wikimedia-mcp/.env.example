# ── Required ────────────────────────────────────────────────────────────────
# Contactable User-Agent sent on EVERY outbound Wikimedia request. Required.
USER_AGENT=WikiMCP/1.0 (https://example.org/wikimedia-mcp; contact: ops@example.org)

# ── Politeness / upstream ───────────────────────────────────────────────────
# Values > 3 are rejected at boot. Default 3.
CONCURRENCY_LIMIT=3
HTTP_TIMEOUT_MS=15000
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_MS=250
RETRY_BACKOFF_MAX_MS=5000
RETRY_AFTER_FALLBACK_MS=5000
METADATA_CACHE_TTL_MS=3600000
MAX_RESULT_BYTES=65536

# ── Transport / listener ────────────────────────────────────────────────────
# stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
# Required when MCP_HTTP_HOST is not a loopback address.
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
LOG_LEVEL=info

# ── HTTP hardening (report 08 §5.9.1 / T-11) ────────────────────────────────
# Both default to false so local / non-browser hosts keep working.
# MUST be true for ANY future write-enabled deployment.
# REQUIRE_ORIGIN=true rejects requests with no Origin header (HTTP 403);
#             set MCP_ALLOWED_ORIGINS to explicit origins (never '*').
MCP_REQUIRE_ORIGIN=false
# REQUIRE_CSRF=true requires a signed Mcp-Csrf-Token on state-changing calls
#             and issues one in the MCP-CSRF-Token response header.
MCP_REQUIRE_CSRF=false
# At least 16 characters when REQUIRE_CSRF=true; boot fails otherwise.
MCP_CSRF_SECRET=
MCP_CSRF_TOKEN_TTL_MS=300000

# ── Wikidata SPARQL (day-1 config; Group B ships later) ─────────────────────
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
WIKIDATA_SPARQL_ENDPOINT_V2=https://query-next.wikidata.org/sparql
WIKIDATA_SPARQL_FALLBACKS=https://query-main.wikidata.org/sparql
WIKIDATA_SPARQL_PREFER_V2=false
WIKIDATA_SPARQL_ACCEPT=application/sparql-results+json
WIKIDATA_SPARQL_TIMEOUT_MS=60000
WIKIDATA_SPARQL_MAX_ROWS=1000
WIKIDATA_SPARQL_MAX_QUERY_LENGTH=10000

# ── Attribution API (day-1 config; Group F ships later) ─────────────────────
ATTRIBUTION_API_VERSION=v0-beta
ATTRIBUTION_FALLBACKS=rest-bare,action-rightsinfo,action-imageinfo
ATTRIBUTION_DISCLAIMER=You remain responsible for licence compliance.
