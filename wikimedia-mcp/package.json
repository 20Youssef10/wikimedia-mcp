{
  "name": "wikimedia-mcp",
  "version": "3.0.0",
  "description": "Unified Wikimedia MCP server — read-only Phases 1+2+3, MCP 2026-07-28",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:sdk": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2023 --strict --types node verify-sdk.ts",
    "verify:catalogue": "node scripts/assert-catalogue.mjs",
    "verify:read-only": "node scripts/assert-read-only.mjs",
    "start": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "p-limit": "7.3.3",
    "p-retry": "9.0.0",
    "undici": "8.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "msw": "3.0.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
